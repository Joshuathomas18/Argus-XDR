# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Configuration (optional, for direct Postgres connection)
DATABASE_URL=postgresql://user:password@localhost:5432/argus_xdr
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIMENSION=384

# Model Cache
HF_HOME=~/.cache/huggingface
TORCH_HOME=~/.cache/torch

# LLM Configuration (for post-MVP agent)
LLM_PROVIDER=openrouter
LLM_API_KEY=your-api-key
LLM_MODEL=openrouter/meta-llama/llama-2-70b-chat

# Application Configuration
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# RAG Configuration
KNOWLEDGE_BASE_SIZE=100
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.3

# Feature Flags
ENABLE_RERANKING=True
ENABLE_HYBRID_SEARCH=True
